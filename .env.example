# Claude (javob yozish uchun LLM) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voyage AI (embedding — matnni vektorga aylantirish) — https://dash.voyageai.com
# Anthropic tavsiya qiladigan embedding provayder, Claude bilan birga ishlaydi
VOYAGE_API_KEY=

# Supabase loyihangiz — https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# "anon" (public) kalit — login/logout uchun, brauzerda ishlatilishi XAVFSIZ
# (himoya RLS orqali, kalitning o'zi orqali emas)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bu "service_role" kalit — MAXFIY, faqat serverda ishlatiladi, hech qachon
# frontendga yoki NEXT_PUBLIC_ prefiksi bilan chiqarilmasin
SUPABASE_SERVICE_ROLE_KEY=
